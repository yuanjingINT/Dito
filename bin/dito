#!/usr/bin/env node
// Dito 启动器（跨平台：Linux / macOS / Windows）。
// 负责：定位项目根目录、按 Node 版本补 node:sqlite 的 flag、经 tsx 拉起 bin/dito.ts。
// npm 全局安装时，npm 的 cmd-shim 会识别本文件头部的 node shebang，在 Windows 生成 .cmd 垫片。
import { existsSync } from "node:fs";
import { createRequire } from "node:module";
import path from "node:path";
import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const entry = path.join(root, "bin", "dito.ts");

const [maj, min] = process.versions.node.split(".").map(Number);
if (maj < 22 || (maj === 22 && min < 5)) {
  console.error(`[dito] 需要 Node ≥ 22.5（当前 ${process.versions.node}）：https://nodejs.org`);
  process.exit(1);
}

if (!existsSync(path.join(root, "node_modules", "tsx"))) {
  console.error(`[dito] 第一次跑得先装依赖：cd '${root}' && npm install`);
  process.exit(1);
}

// node:sqlite：Node 22.5 引入但需 flag，23.4+ / 24+ 默认启用，按版本自动补 --experimental-sqlite。
const env = { ...process.env };
if (maj < 24 && (maj < 23 || min < 4)) {
  env.NODE_OPTIONS = `${env.NODE_OPTIONS ? env.NODE_OPTIONS + " " : ""}--experimental-sqlite`;
}

// tsx 的 CLI 入口用文件路径直取，避开 exports 映射在不同 tsx 版本间的差异。
const tsxCli = path.join(root, "node_modules", "tsx", "dist", "cli.mjs");
if (!existsSync(tsxCli)) {
  console.error("[dito] tsx 安装不完整，请重新 npm install");
  process.exit(1);
}

const child = spawn(process.execPath, [tsxCli, entry, ...process.argv.slice(2)], {
  cwd: root,
  env,
  stdio: "inherit",
});
child.on("exit", (code, signal) => {
  if (signal) process.kill(process.pid, signal);
  else process.exitCode = code ?? 1;
});
for (const sig of ["SIGINT", "SIGTERM"]) {
  process.on(sig, () => child.kill(sig));
}
