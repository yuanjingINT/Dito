{
  "name": "dito",
  "version": "0.2.1-preview",
  "description": "Dito（蒂特）—— 基于 pi agent 的 QQ/终端 AI 助手：语音对话、知识库、记忆、SnowLuma QQ 频道、Matrix 频道、联网搜索、权限门，默认模型为 opencode 免费公共模型",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "dito": "./bin/dito",
    "dito-relay": "./relay/server.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "assistant",
    "dito",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.15",
    "@snowluma/sdk": "^1.14.15",
    "matrix-bot-sdk": "^0.8.0",
    "matrix-js-sdk": "^42.3.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.12",
    "typebox": "^1.3.13",
    "ws": "^8.21.3"
  },
  "scripts": {},
  "author": "yuanjingINT",
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1"
  },
  "files": [
    "bin/",
    "extensions/",
    "relay/",
    "personas/",
    "identities/",
    "system-prompts/",
    "skills/",
    "config/",
    "kb/",
    "docs/",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.5"
  }
}
